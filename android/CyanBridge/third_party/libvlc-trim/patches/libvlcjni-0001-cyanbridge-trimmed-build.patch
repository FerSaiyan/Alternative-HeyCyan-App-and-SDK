-    --disable-chromaprint \
-    --enable-lua \
-    --disable-sdl \
-    --disable-SDL_image \
-    --enable-zvbi \
-    --disable-kate \
-    --disable-caca \
-    --disable-mpcdec \
-    --enable-upnp \
-    --enable-gme \
-    --disable-tremor \
-    --enable-vorbis \
-    --disable-sidplay2 \
-    --disable-samplerate \
-    --disable-faad2 \
-    --enable-harfbuzz \
-    --enable-iconv \
-    --disable-aribb24 \
-    --disable-aribb25 \
-    --enable-mpg123 \
-    --enable-libdsm \
-    --enable-smb2 \
-    --enable-libarchive \
-    --disable-libmpeg2 \
-    --enable-soxr \
-    --enable-nfs \
-    --enable-microdns \
-    --enable-fluidlite \
-    --disable-mad \
-    --disable-vncclient \
-    --disable-vnc \
