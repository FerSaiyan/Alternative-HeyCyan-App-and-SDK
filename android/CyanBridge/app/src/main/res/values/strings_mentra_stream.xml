    <string name="mentra_broadcast_title">Mentra Live broadcast</string>
    <string name="mentra_broadcast_intro">Mentra Live streams its camera and microphone straight to your own RTMP or SRT server over the glasses\' Wi-Fi. The glasses need a Wi-Fi network with internet; this phone only starts, watches and stops the stream.</string>
    <string name="mentra_broadcast_url_label">Server URL</string>
    <string name="mentra_broadcast_url_hint">rtmp://server/app/stream-key or srt://server:port</string>
