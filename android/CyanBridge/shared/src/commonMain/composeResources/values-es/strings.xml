    <string name="onboarding_welcome_title">Bienvenido a CyanBridge</string>
    <string name="onboarding_welcome_body">Conecta tus gafas inteligentes y configura Android para mantener una conexión estable en segundo plano.</string>
    <string name="onboarding_start_setup">Iniciar configuración</string>
    <string name="onboarding_setup">Configuración</string>
    <string name="onboarding_connect_glasses_title">Conecta tus gafas</string>
    <string name="onboarding_connect_glasses_body">CyanBridge necesita acceso a dispositivos cercanos para detectar y conectar tus gafas. En teléfonos antiguos, Android también puede solicitar ubicación porque la necesita para buscar dispositivos Bluetooth. El permiso de Wi-Fi Direct se solicitará más adelante, solo al transferir archivos.</string>
    <string name="onboarding_bluetooth_allowed">Acceso Bluetooth permitido</string>
    <string name="onboarding_bluetooth_denied">No se ha concedido el acceso Bluetooth</string>
    <string name="onboarding_allow_glasses_connection">Permitir conexión de las gafas</string>
    <string name="onboarding_permission_granted">Permiso concedido</string>
    <string name="onboarding_media_files_title">Archivos multimedia y de IA</string>
    <string name="onboarding_media_files_body">CyanBridge usa el acceso a archivos para guardar los archivos transferidos desde tus gafas y administrar modelos de IA y archivos locales relacionados. Puedes continuar sin concederlo ahora, pero la sincronización multimedia y algunas funciones de IA lo necesitarán más adelante.</string>
    <string name="onboarding_file_access_allowed">Acceso a archivos permitido</string>
    <string name="onboarding_file_access_denied">No se ha concedido el acceso a archivos</string>
    <string name="onboarding_allow_media_access">Permitir acceso a multimedia y archivos de IA</string>
    <string name="onboarding_accessibility_title">Información sobre accesibilidad</string>
    <string name="onboarding_accessibility_body">Local Agent puede leer el texto de la pantalla para realizar las acciones que solicites explícitamente. No se ejecutará hasta que actives el acceso de accesibilidad en los ajustes de Android.</string>
    <string name="onboarding_local_agent_toggle">Activar automatización de Local Agent</string>
    <string name="onboarding_accessibility_enabled">La accesibilidad está activada</string>
    <string name="onboarding_accessibility_disabled">La accesibilidad está desactivada</string>
    <string name="onboarding_open_accessibility">Abrir ajustes de accesibilidad</string>
    <string name="onboarding_open_source_title">Código abierto por diseño</string>
    <string name="onboarding_open_source_body">Consulta cómo funciona CyanBridge, informa de problemas de seguridad, sugiere mejoras o contribuye con código. La revisión de la comunidad ayuda a que la aplicación sea más segura y útil.</string>
    <string name="onboarding_open_github">Abrir CyanBridge en GitHub</string>
