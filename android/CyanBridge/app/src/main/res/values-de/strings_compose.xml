    <string name="compose_enable_telegram">Telegram-Fernsteuerung des Telefons aktivieren</string>
    <string name="compose_telegram_commands">Unterstützte Befehle: /task &lt;Anfrage&gt;, /status, /read, /stop. /task verwendet dieselben Bestätigungs- und Datenschutzregeln wie Local Agent; /read wird gemäß Standardrichtlinie zur Bestätigung vorgemerkt.</string>
