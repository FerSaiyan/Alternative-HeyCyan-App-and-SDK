<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemini Live"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gemini_live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Preview is ready"
        android:textColor="@color/cyan_accent"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/gemini_live_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Session not running"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/gemini_live_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Network: checking"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/gemini_live_indicators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Microphone: off   Glasses camera: off"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gemini_live_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Start Gemini Live" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gemini_live_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stop" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="The microphone remains available for follow-up questions. Free sessions use the secure CyanBridge Live proxy; paid Pro sessions connect with a constrained token."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
