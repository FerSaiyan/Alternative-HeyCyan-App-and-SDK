<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Legacy Android 7-9 compatibility only. Android 10+ uses scoped MediaStore/app storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Narrow package visibility replaces QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="com.glasssutdio.wear" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="com.joaomgcd.autoinput" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.stella" />
        <package android:name="com.facebook.stella_debug" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:name=".ui.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyanBridgeManager"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <uses-native-library android:name="libvulkan.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <meta-data android:name="com.meta.wearable.mwdat.APPLICATION_ID" android:value="${mwdat_application_id}" />
        <meta-data android:name="com.meta.wearable.mwdat.CLIENT_TOKEN" android:value="${mwdat_client_token}" />
        <meta-data android:name="com.meta.wearable.mwdat.DAM_ENABLED" android:value="true" />
        <meta-data android:name="com.mentra.bluetoothsdk.analytics.disabled" android:value="true" />

        <!-- The only screen host: every in-app screen is a destination of its back stack. singleTask keeps
             one instance (one glasses host); intents for it arrive in onNewIntent. -->
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name" android:launchMode="singleTask" />
        <!-- The launcher icon keeps the old launcher Activity's name (pinned shortcuts); MainActivity shows onboarding first when needed. -->
        <activity-alias android:name=".ui.WelcomeActivity" android:targetActivity=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Meta AI registration callback (cyanbridge://): forwards to the Meta setup screen in MainActivity. -->
        <activity android:name=".ui.MetaPairingActivity" android:exported="true" android:launchMode="singleTask" android:label="@string/meta_pairing_title" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cyanbridge" />
            </intent-filter>
        </activity>
        <service android:name=".devices.meizumyvu.MeizuMyvuConnectionService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <!-- Deep-link entry: forwards to the Pro screen in MainActivity. -->
        <activity android:name=".agent.ProSubscriptionActivity" android:exported="true" android:label="Pro Subscription" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fersaiyan" android:host="pro-sub" android:path="/restore" />
            </intent-filter>
        </activity>
        <activity android:name=".agent.WebSubscriptionCallbackActivity" android:exported="true" android:label="Subscription Callback" android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cyanbridge.vercel.app" android:path="/web-subscribe/callback" />
            </intent-filter>
        </activity>
        <activity android:name=".ai.live.GeminiLivePermissionGateActivity" android:exported="false" android:label="Gemini Live Permissions" />
        <activity
            android:name=".devices.memomind.webplugin.MemoMindWebPluginsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false" />

        <service android:name=".localmodels.download.ModelDownloadForegroundService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service
            android:name=".localmodels.benchmark.LocalModelBenchmarkMtpOffService"
            android:exported="false"
            android:process=":benchmark_mtp_off" />
        <service
            android:name=".localmodels.benchmark.LocalModelBenchmarkMtpOnService"
            android:exported="false"
            android:process=":benchmark_mtp_on" />
        <service android:name=".ai.AiQuestionForegroundService" android:exported="false" android:foregroundServiceType="connectedDevice|dataSync|microphone" />
        <service android:name=".ai.live.GeminiLiveForegroundService" android:exported="false" android:foregroundServiceType="microphone|connectedDevice|mediaPlayback|dataSync" />
        <service android:name=".devices.eyevue.EyevueLiveForegroundService" android:exported="false" android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service android:name=".devices.heycyan.HeyCyanLiveForegroundService" android:exported="false" android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service android:name=".devices.tunebuds.TuneBudsLiveForegroundService" android:exported="false" android:foregroundServiceType="connectedDevice|mediaPlayback" />
        <service android:name=".plugins.walkingaid.WalkingAidService" android:exported="false" android:foregroundServiceType="dataSync|connectedDevice" />
        <service android:name=".plugins.meetingsparknotes.MeetingSparkNotesService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".plugins.livecaptionrelay.LiveCaptionRelayService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".plugins.mentra.MentraMiniappService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".plugins.handsfreetranslator.HandsFreeTranslatorService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".plugins.errandbrain.ErrandBrainService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".plugins.visualdiary.VisualDiaryService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".plugins.autodiary.AutoDiaryTaskerCaptureReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.fersaiyan.cyanbridge.TASKER_AUTO_DIARY_CAPTURE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".plugins.visualdiary.VisualDiaryTaskerCaptureReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.fersaiyan.cyanbridge.TASKER_VISUAL_DIARY_CAPTURE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".plugins.errandbrain.ErrandBrainReminderReceiver" android:exported="false" />
        <receiver android:name=".ai.image.ImageAutomationStatusReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.fersaiyan.cyanbridge.AI_IMAGE_STATUS" />
                <action android:name="com.fersaiyan.cyanbridge.AI_IMAGE_PROFILE" />
            </intent-filter>
        </receiver>
        <service android:name=".audio.MeetingCaptureService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".localagent.TaskerLocalAgentService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".media.autocapture.AutoAudioCaptureService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".studiobridge.StudioBridgeForegroundService" android:exported="false" android:foregroundServiceType="microphone" />
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <service android:name=".bridge.notifications.NotificationForwarderService" android:exported="true" android:label="CyanBridge notification forwarding" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <receiver android:name=".localagent.daily.DailyFactsReminderReceiver" android:exported="false" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
