    <string name="onboarding_language_title">Scegli la lingua dell'app</string>
    <string name="onboarding_language_description">Seleziona la lingua che CyanBridge userà per la configurazione, le impostazioni dei plugin, le schermate e le finestre di dialogo.</string>
