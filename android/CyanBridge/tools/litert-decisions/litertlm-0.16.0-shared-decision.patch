+// Decision scoring uses existing native teacher-forcing, which returns log p
+// (not negative log p, despite the SessionInterface comment in this revision).
+// Clone one prefilled session per label so every score has identical context.
+// Only one clone is alive at a time; all sessions share this engine's executor.
+//
+// In this revision RunTextScoring scores the FIRST target token against the
+// stale distribution that predicted the last prefilled token; later target
+// tokens are conditioned correctly (verified on Gemma 4 E2B against greedy
+// decode and HF transformers). The prompt must therefore end with the decision
+// delimiter: we prefill everything before it, score delimiter + label, and keep
+// only the label token's score, so the mis-scored position is a discarded
+// delimiter token.
+constexpr absl::string_view kDecisionDelimiter = "\xE2\x8A\xB2";  // U+22B2
+LITERTLM_JNIEXPORT jfloatArray JNICALL JNI_METHOD(nativeScoreDecision)(
+    JNIEnv* env, jclass thiz, jlong engine_pointer, jbyteArray prompt_bytes,
+    jobjectArray label_array) {
+  if (engine_pointer == 0 || prompt_bytes == nullptr || label_array == nullptr) {
+    ThrowLiteRtLmJniException(env, "Missing decision engine, prompt or labels");
+    return nullptr;
+  }
+  auto* engine = reinterpret_cast<Engine*>(engine_pointer);
+  const int count = env->GetArrayLength(label_array);
+  const int prompt_size = env->GetArrayLength(prompt_bytes);
+  if (count < 2 || count > 26 || prompt_size == 0) {
+    ThrowLiteRtLmJniException(env, "Need a nonempty prompt and 2..26 labels");
+    return nullptr;
+  }
+  std::string prompt(prompt_size, '\0');
+  env->GetByteArrayRegion(prompt_bytes, 0, prompt_size,
+                         reinterpret_cast<jbyte*>(prompt.data()));
+  if (env->ExceptionCheck()) return nullptr;
+  if (!absl::EndsWith(prompt, kDecisionDelimiter) ||
+      prompt.size() == kDecisionDelimiter.size()) {
+    ThrowLiteRtLmJniException(env, "Decision prompt must end with the U+22B2 delimiter");
+    return nullptr;
+  }
+  const std::string context = prompt.substr(0, prompt.size() - kDecisionDelimiter.size());
+  // Engine exposes a const tokenizer; encoding is non-const. Same cast as c/engine.cc.
+  auto& tokenizer =
+      const_cast<::litert::support::Tokenizer&>(engine->GetTokenizer());
+  auto context_ids = tokenizer.TextToTokenIds(context);
+  auto prefix_ids = tokenizer.TextToTokenIds(prompt);
+  if (!context_ids.ok() || !prefix_ids.ok()) {
+    ThrowLiteRtLmJniException(env, (context_ids.ok() ? prefix_ids.status() : context_ids.status()).ToString());
+    return nullptr;
+  }
+  // The delimiter must append whole tokens without retokenizing the context.
+  const int delimiter_tokens = static_cast<int>(prefix_ids->size() - context_ids->size());
+  if (context_ids->empty() || delimiter_tokens <= 0 ||
+      !std::equal(context_ids->begin(), context_ids->end(), prefix_ids->begin())) {
+    ThrowLiteRtLmJniException(env, "Delimiter retokenizes the decision context");
+    return nullptr;
+  }
+  const int capacity =
+      engine->GetEngineSettings().GetMainExecutorSettings().GetMaxNumTokens();
+  if (capacity <= 0 || prefix_ids->size() + 1 >= capacity) {
+    ThrowLiteRtLmJniException(env, "Decision prompt exceeds configured context");
+    return nullptr;
+  }
+  std::vector<std::string> labels;
+  std::vector<int> label_ids;
+  absl::flat_hash_set<int> token_ids;
+  for (int i = 0; i < count; ++i) {
+    auto label = static_cast<jstring>(env->GetObjectArrayElement(label_array, i));
+    if (env->ExceptionCheck()) return nullptr;
+    if (label == nullptr || env->GetStringLength(label) != 1) {
+      if (label != nullptr) env->DeleteLocalRef(label);
+      ThrowLiteRtLmJniException(env, "Labels must be ASCII A..Z");
+      return nullptr;
+    }
+    jchar ch;
+    env->GetStringRegion(label, 0, 1, &ch);
+    env->DeleteLocalRef(label);
+    if (env->ExceptionCheck()) return nullptr;
+    if (ch < 'A' || ch > 'Z') {
+      ThrowLiteRtLmJniException(env, "Labels must be ASCII A..Z");
+      return nullptr;
+    }
+    std::string text(1, static_cast<char>(ch));
+    auto standalone = tokenizer.TextToTokenIds(text);
+    auto joined = tokenizer.TextToTokenIds(prompt + text);
+    if (!standalone.ok() || !joined.ok() || standalone->size() != 1 ||
+        joined->size() != prefix_ids->size() + 1 ||
+        !std::equal(prefix_ids->begin(), prefix_ids->end(), joined->begin()) ||
+        joined->back() != standalone->front() ||
+        !token_ids.insert(standalone->front()).second) {
+      ThrowLiteRtLmJniException(env,
+          "Label is not a distinct single-token continuation of full prompt");
+      return nullptr;
+    }
+    labels.push_back(std::string(kDecisionDelimiter) + text);
+    label_ids.push_back(standalone->front());
+  }
+  auto config = SessionConfig::CreateDefault();
+  auto base = engine->CreateSession(config);
+  if (!base.ok()) {
+    ThrowLiteRtLmJniException(env, base.status().ToString());
+    return nullptr;
+  }
+  std::vector<InputData> contents;
+  contents.emplace_back(InputText(context));
+  auto status = (*base)->RunPrefill(contents);
+  if (!status.ok()) {
+    ThrowLiteRtLmJniException(env, status.ToString());
+    return nullptr;
+  }
+  // Single pass: score delimiter + first label once. The final step's logits
+  // predict the label position, so every candidate is read from that one
+  // full-vocabulary log-softmax (the delimiter's first token absorbs the
+  // stale-first-step behaviour). Runtimes without it report Unimplemented,
+  // and we fall back to one cloned session per label.
+  std::vector<float> values;
+  auto single = (*base)->RunCandidateScoring(labels.front(), label_ids);
+  if (single.ok()) {
+    const auto& candidates = single->GetCandidateLogProbs();
+    const auto& token_scores = single->GetTokenScores();
+    if (!candidates.has_value() || candidates->size() != label_ids.size() ||
+        !token_scores.has_value() || token_scores->size() != 1 ||
+        (*token_scores)[0].size() != delimiter_tokens + 1) {
+      ThrowLiteRtLmJniException(env, "Unexpected single-pass candidate scores");
+      return nullptr;
+    }
+    // Self-check: the runtime's own teacher-forced score for the first label
+    // must equal the same quantity read from the candidate log-softmax.
+    if (!(std::abs((*token_scores)[0].back() - candidates->front()) <= 1e-3f)) {
+      ThrowLiteRtLmJniException(env, "Single-pass candidate scores disagree with teacher forcing");
+      return nullptr;
+    }
+    values = *candidates;
+  } else if (single.status().code() != absl::StatusCode::kUnimplemented) {
+    ThrowLiteRtLmJniException(env, single.status().ToString());
+    return nullptr;
+  } else {
+    for (const auto& label : labels) {
+      auto fork = (*base)->Clone();
+      if (!fork.ok()) {
+        ThrowLiteRtLmJniException(env, fork.status().ToString());
+        return nullptr;
+      }
+      auto response = (*fork)->RunTextScoring({label}, true);
+      if (!response.ok()) {
+        ThrowLiteRtLmJniException(env, response.status().ToString());
+        return nullptr;
+      }
+      const auto& token_scores = response->GetTokenScores();
+      if (!token_scores.has_value() || token_scores->size() != 1 ||
+          (*token_scores)[0].size() != delimiter_tokens + 1) {
+        ThrowLiteRtLmJniException(env, "Unexpected delimiter + label token scores");
+        return nullptr;
+      }
+      // log p(label | context + delimiter); the leading delimiter scores are discarded.
+      values.push_back((*token_scores)[0].back());
+    }
+  }
+  double mass = 0;
+  for (float score : values) {
+    if (!std::isfinite(score) || score > 0) {
+      ThrowLiteRtLmJniException(env, "Invalid single-token log probability");
+      return nullptr;
+    }
+    mass += std::exp(static_cast<double>(score));
+  }
+  if (!std::isfinite(mass) || mass > 1.0001) {
+    ThrowLiteRtLmJniException(env, "Invalid full-vocabulary label mass");
+    return nullptr;
+  }
+  values.push_back(static_cast<float>(std::min(1.0, mass)));
+  auto result = env->NewFloatArray(values.size());
+  if (result == nullptr) return nullptr;
+  env->SetFloatArrayRegion(result, 0, values.size(), values.data());
+  return result;
+}
