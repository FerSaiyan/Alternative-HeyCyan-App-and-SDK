<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lensmoo_private.xml"/>
        <exclude domain="sharedpref" path="remote_openai_secrets.xml"/>
        <exclude domain="sharedpref" path="pro_subscription_server_prefs.xml"/>
        <exclude domain="sharedpref" path="pro_subscription_server_secrets.xml"/>
        <exclude domain="sharedpref" path="pending_donation_prefs.xml"/>
        <exclude domain="sharedpref" path="pending_donation_secrets.xml"/>
        <exclude domain="sharedpref" path="pending_legacy_checkout_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lensmoo_private.xml"/>
        <exclude domain="sharedpref" path="remote_openai_secrets.xml"/>
        <exclude domain="sharedpref" path="pro_subscription_server_prefs.xml"/>
        <exclude domain="sharedpref" path="pro_subscription_server_secrets.xml"/>
        <exclude domain="sharedpref" path="pending_donation_prefs.xml"/>
        <exclude domain="sharedpref" path="pending_donation_secrets.xml"/>
        <exclude domain="sharedpref" path="pending_legacy_checkout_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
