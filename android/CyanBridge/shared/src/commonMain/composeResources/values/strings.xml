    <string name="onboarding_connect_glasses_title">Connect your glasses</string>
    <string name="onboarding_connect_glasses_body">CyanBridge needs nearby-device access to discover and connect to your glasses. Android may also request location on older phones because it requires it for Bluetooth scanning. Wi-Fi Direct permission is requested later, only when you transfer media.</string>
