    <string name="onboarding_language_title">App-Sprache auswählen</string>
    <string name="onboarding_language_description">Wählen Sie die Sprache aus, die CyanBridge für Einrichtung, Plugin-Einstellungen, Bildschirme und Dialoge verwenden soll.</string>
