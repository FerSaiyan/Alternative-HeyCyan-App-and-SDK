-    --enable-zvbi \
-    --disable-fluidsynth \
-    --enable-fluidlite \
-    --disable-jack \
-    --disable-pulse \
-    --disable-alsa \
-    --disable-samplerate \
+    --disable-linsys \
+    --disable-decklink \
     --disable-xcb \
     --disable-qt \
     --disable-skins2 \
+    --disable-alsa \
+    --disable-pulse \
+    --disable-jack \
+    --disable-udev \
     --disable-mtp \
     --disable-notify \
-    --enable-libass \
     --disable-svg \
-    --disable-udev \
-    --enable-libxml2 \
+    --disable-svgdec \
+    --disable-sdl-image \
     --disable-caca \
-    --enable-gles2 \
     --disable-goom \
     --disable-projectm \
-    --enable-sout \
-    --enable-vorbis \
+    --disable-libxml2 \
+    --disable-taglib \
+    --disable-freetype \
+    --disable-fribidi \
+    --disable-harfbuzz \
+    --disable-fontconfig \
+    --disable-libass \
+    --disable-gnutls \
+    --disable-libgcrypt \
+    --disable-bluray \
+    --disable-smb2 \
+    --disable-dsm \
+    --disable-nfs \
+    --disable-sftp \
+    --disable-upnp \
+    --disable-microdns \
