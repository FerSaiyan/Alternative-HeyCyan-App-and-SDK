    <string name="compose_local_agent_title">Local Agent</string>
    <string name="compose_local_agent_intro">Private Telefonautomatisierung mit dem vorhandenen Bedienungshilfen-Dienst. Der Agent kann Bildschirmaktionen planen, für riskante Vorgänge eine Bestätigung verlangen und Ihren lokalen Speicher verwenden.</string>
    <string name="compose_local_agent_enable">Local-Agent-Telefonsteuerung aktivieren</string>
    <string name="compose_local_agent_planning">Planung</string>
    <string name="compose_local_agent_provider_description">KI-Anbieter und lokale Modelle werden in den Einstellungen verwaltet.</string>
    <string name="compose_open_settings">Einstellungen öffnen</string>
    <string name="compose_local_agent_screenshot_planning">Planung mit Screenshots</string>
    <string name="compose_local_agent_screenshot_description">Screenshots sind standardmäßig aus. Damit der Planer den Bildschirm sieht, setzen Sie im Tasker-Profil „CyanBridge Local Agent“ die Variable CB_LocalAgentScreenshot auf 1. Tasker sendet dann mit jeder Beobachtung einen Screenshot, und CyanBridge löscht ihn nach dem Planungsschritt. Bei einem Cloud- oder Pro-Planer wird der Screenshot an diesen Anbieter gesendet.</string>
    <string name="compose_local_agent_screenshot_status">Screenshot-Status: %1$s</string>
    <string name="compose_local_agent_runtime_safety">Laufzeit und Sicherheit</string>
    <string name="compose_local_agent_runtime_description">Der Agent kann zugängliche App-Oberflächen prüfen, tippen, Text eingeben, Felder absenden, scrollen und Apps öffnen. Anrufe, SMS und E-Mails öffnen den nativen Wähler oder Verfasser und gelten gemäß Standardrichtlinie als risikoreich. Telefonsteuerung und Screenshotplanung werden bei gesperrtem oder inaktivem Telefon beendet.</string>
    <string name="compose_local_agent_accessibility_service">Bedienungshilfen-Dienst</string>
