    <string name="onboarding_battery_title">배터리 최적화</string>
    <string name="onboarding_battery_headline">CyanBridge 계속 실행</string>
    <string name="onboarding_battery_body">Android 배터리 최적화는 Bluetooth, 미디어 동기화, 로컬 자동화 및 회의 캡처를 중단할 수 있습니다.</string>
    <string name="onboarding_battery_disabled">CyanBridge의 배터리 최적화가 사용 중지되었습니다.</string>
    <string name="onboarding_battery_enabled">CyanBridge의 배터리 최적화가 현재 사용 설정되어 있습니다.</string>
