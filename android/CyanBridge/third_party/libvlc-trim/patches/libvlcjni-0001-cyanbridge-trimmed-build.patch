From 99f745996961872215f0c8c488943161f7b2f4f5 Mon Sep 17 00:00:00 2001
From: libvlc-trim <libvlc-trim@localhost>
Date: Sat, 21 Nov 2026 17:05:40 -0300
Subject: [PATCH] CyanBridge trimmed build

- compile-libvlc.sh: one NDK (r27-29) and API level for all ABIs; build only
  the contribs in AVLC_CONTRIB_TARGETS with the ffmpeg options in
  AVLC_FFMPEG_TRIM_CONF; configure VLC without optional dependencies; link
  only the modules listed in AVLC_MODULES_FILE; build only libtool from
  extras/tools.
- Android.mk: do not link libjpeg (not built).
- libvlcjni.c: build without fontconfig; nativeBuildFontCache() then has
  nothing to do and returns true.
---
 buildsystem/compile-libvlc.sh | 252 +++++++++++++---------------------
 libvlc/jni/Android.mk         |   1 -
 libvlc/jni/libvlcjni.c        |  13 ++
 3 files changed, 105 insertions(+), 161 deletions(-)

diff --git a/buildsystem/compile-libvlc.sh b/buildsystem/compile-libvlc.sh
index b67c1e6..cf03028 100755
--- a/buildsystem/compile-libvlc.sh
+++ b/buildsystem/compile-libvlc.sh
@@ -115,19 +115,13 @@ fi
 # try to detect NDK version
 REL=$(grep -o '^Pkg.Revision.*[0-9]*.*' $ANDROID_NDK/source.properties |cut -d " " -f 3 | cut -d "." -f 1)
 
-if [ "${HAVE_64}" = 1 ]; then
-    if [ "$REL" != 27 ] && [ "$REL" != 28 ] && [ "$REL" != 29 ]; then
-        echo "NDK v27-29 needed for 64-bit, got $REL, cf. https://developer.android.com/ndk/downloads/"
-        exit 1
-    fi
-    ANDROID_API=21
-else
-    if [ "$REL" != 21 ]; then
-        echo "NDK v21 needed for 32-bit, got $REL cf. https://developer.android.com/ndk/downloads/"
-        exit 1
-    fi
-    ANDROID_API=17
+# CyanBridge trim: one NDK (r27-29) for all four ABIs, API level from
+# AVLC_ANDROID_API (default 28 = the app's minSdk; bionic has iconv from 28).
+if [ "$REL" != 27 ] && [ "$REL" != 28 ] && [ "$REL" != 29 ]; then
+    echo "NDK v27-29 needed, got $REL, cf. https://developer.android.com/ndk/downloads/"
+    exit 1
 fi
+ANDROID_API=${AVLC_ANDROID_API:-28}
 
 ############
 # VLC PATH #
@@ -255,7 +249,7 @@ avlc_checkfail()
 
 avlc_find_modules()
 {
-    echo "$(find $1 -name 'lib*plugin.a' | grep -vE "lib(${blacklist_regexp})_plugin.a" | tr '\n' ' ')"
+    echo "$(find $1 -name 'lib*plugin.a' | grep -E "/lib(${whitelist_regexp})_plugin.a$" | tr '\n' ' ')"
 }
 
 avlc_get_symbol()
@@ -288,49 +282,13 @@ avlc_build()
