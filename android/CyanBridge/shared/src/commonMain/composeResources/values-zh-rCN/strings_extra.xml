    <string name="dashboard_ota_description">为两颗芯片执行一次受控更新：先更新 Wi-Fi .swu，再经过新的就绪检查更新 BLE .bin。</string>
    <string name="dashboard_choose_ota_files">选择组合 OTA 文件</string>
