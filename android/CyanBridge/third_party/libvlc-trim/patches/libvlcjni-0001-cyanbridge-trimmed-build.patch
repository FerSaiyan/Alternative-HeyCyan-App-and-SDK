     --disable-update-check \
     --disable-vlm \
+    --disable-sout \
+    --disable-lua \
+    --disable-addonmanagermodules \
+    --enable-avcodec \
+    --disable-avformat \
+    --disable-swscale \
+    --disable-postproc \
+    --enable-dvbpsi \
+    --enable-opensles \
+    --enable-gles2 \
+    --disable-a52 \
     --disable-dbus \
-    --enable-lua \
     --disable-vcd \
     --disable-v4l2 \
-    --enable-bluray \
-    --disable-linsys \
-    --disable-decklink \
     --disable-libva \
     --disable-dv1394 \
-    --enable-mod \
-    --disable-sid \
