    <string name="meta_setup_choice_title">How do you connect to Meta AI?</string>
    <string name="meta_setup_choice_dev_mode">I use Developer Mode</string>
    <string name="meta_setup_choice_dev_mode_detail">For people who already turned on Developer Mode in the Meta AI app.</string>
    <string name="meta_setup_choice_email">Request access with my Meta email</string>
    <string name="meta_setup_choice_email_detail">CyanBridge adds your Meta account to its testers, and Meta emails you an invite.</string>
    <string name="meta_setup_choice_email_unavailable">Access by email is not available in this version yet. Use Developer Mode.</string>
    <string name="meta_setup_dev_step_1">1. In Meta AI, open Settings, then App info.</string>
    <string name="meta_setup_dev_step_2">2. Tap the app version 5 times (with a screen reader, double-tap it 5 times), then turn on Developer Mode.</string>
    <string name="meta_setup_dev_step_3">3. Return here and tap Register.</string>
    <string name="meta_setup_email_step_1">1. Open the access form and enter the email of your Meta account.</string>
    <string name="meta_setup_email_step_2">2. When you are accepted, open Meta’s invite email and accept it.</string>
    <string name="meta_setup_email_step_3">3. In Meta AI, turn Developer Mode off. With it on, CyanBridge connects without release features such as “Hey Meta, open …”.</string>
    <string name="meta_setup_email_step_4">4. Return here and tap Register.</string>
