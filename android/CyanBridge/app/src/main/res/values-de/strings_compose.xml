    <string name="compose_local_agent_notification">Benachrichtigungen vorlesen</string>
    <string name="compose_local_agent_notification_description">Mit Benachrichtigungszugriff kann CyanBridge eingehenden WhatsApp-Benachrichtigungstext vorlesen, solange das Telefon entsperrt ist. Die WhatsApp-Datenbank wird nie gelesen und Benachrichtigungen werden bei gesperrtem Telefon nicht angesagt.</string>
