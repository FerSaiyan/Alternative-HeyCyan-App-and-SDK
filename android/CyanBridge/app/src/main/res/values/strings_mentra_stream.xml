    <string name="mentra_live_preview_title">Mentra Live camera</string>
    <string name="mentra_live_preview_description">Streams the glasses camera to this phone. Mentra Live turns on its hotspot and the phone joins it, unless both are already on the same Wi-Fi. No sound.</string>
    <string name="mentra_live_preview_needs_android_10">Mentra Live preview needs Android 10 or newer.</string>
