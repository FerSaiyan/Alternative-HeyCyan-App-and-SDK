    <string name="onboarding_welcome_title">Bienvenue dans CyanBridge</string>
    <string name="onboarding_welcome_body">Connectez vos lunettes intelligentes et configurez Android pour une connexion stable en arrière-plan.</string>
    <string name="onboarding_start_setup">Commencer la configuration</string>
    <string name="onboarding_setup">Configuration</string>
    <string name="onboarding_connect_glasses_title">Connecter vos lunettes</string>
    <string name="onboarding_connect_glasses_body">CyanBridge a besoin d'accéder aux appareils à proximité pour détecter et connecter vos lunettes. Sur les anciens téléphones, Android peut aussi demander la localisation, nécessaire à la recherche Bluetooth. L'autorisation Wi-Fi Direct sera demandée plus tard, uniquement lors du transfert de médias.</string>
    <string name="onboarding_bluetooth_allowed">Accès Bluetooth autorisé</string>
    <string name="onboarding_bluetooth_denied">L'accès Bluetooth n'est pas autorisé</string>
    <string name="onboarding_allow_glasses_connection">Autoriser la connexion des lunettes</string>
    <string name="onboarding_permission_granted">Autorisation accordée</string>
    <string name="onboarding_media_files_title">Fichiers multimédias et IA</string>
    <string name="onboarding_media_files_body">CyanBridge utilise l'accès aux fichiers pour enregistrer les médias transférés depuis vos lunettes et gérer les modèles d'IA ainsi que les fichiers locaux associés. Vous pouvez continuer sans l'autoriser maintenant, mais la synchronisation des médias et certaines fonctions d'IA en auront besoin plus tard.</string>
    <string name="onboarding_file_access_allowed">Accès aux fichiers autorisé</string>
    <string name="onboarding_file_access_denied">L'accès aux fichiers n'est pas autorisé</string>
    <string name="onboarding_allow_media_access">Autoriser l'accès aux médias et fichiers IA</string>
    <string name="onboarding_accessibility_title">Information sur l'accessibilité</string>
    <string name="onboarding_accessibility_body">Local Agent peut lire le texte à l'écran pour effectuer les actions que vous demandez explicitement. Il ne fonctionne qu'après l'activation de l'accès à l'accessibilité dans les paramètres Android.</string>
    <string name="onboarding_local_agent_toggle">Activer l'automatisation de Local Agent</string>
    <string name="onboarding_accessibility_enabled">L'accessibilité est activée</string>
    <string name="onboarding_accessibility_disabled">L'accessibilité est désactivée</string>
    <string name="onboarding_open_accessibility">Ouvrir les paramètres d'accessibilité</string>
    <string name="onboarding_open_source_title">Open source par conception</string>
    <string name="onboarding_open_source_body">Découvrez le fonctionnement de CyanBridge, signalez les problèmes de sécurité, proposez des améliorations ou contribuez au code. La revue communautaire aide à rendre l'application plus sûre et plus utile.</string>
    <string name="onboarding_open_github">Ouvrir CyanBridge sur GitHub</string>
    <string name="onboarding_skip_all">Tout ignorer</string>
    <string name="onboarding_back">Retour</string>
    <string name="onboarding_next">Suivant</string>
    <string name="onboarding_get_started">Commencer</string>
    <string name="onboarding_battery_title">Optimisation de la batterie</string>
    <string name="onboarding_battery_headline">Garder CyanBridge actif</string>
    <string name="onboarding_battery_body">L'optimisation de la batterie Android peut interrompre le Bluetooth, la synchronisation des médias, l'automatisation locale et l'enregistrement des réunions.</string>
    <string name="onboarding_battery_disabled">L'optimisation de la batterie est désactivée pour CyanBridge.</string>
    <string name="onboarding_battery_enabled">L'optimisation de la batterie est activée pour CyanBridge.</string>
    <string name="onboarding_disable_battery">Désactiver l'optimisation de la batterie</string>
    <string name="onboarding_battery_list">Ouvrir la liste d'optimisation de la batterie</string>
    <string name="onboarding_lock_recents_title">Verrouiller CyanBridge dans les applications récentes</string>
    <string name="onboarding_lock_recents_body">Certains téléphones arrêtent aussi le travail en arrière-plan lorsqu'une application est balayée. Ouvrez les applications récentes, trouvez CyanBridge, puis utilisez Verrouiller, Garder ouvert, Épingler ou Ne pas optimiser. Le nom varie selon le fabricant.</string>
