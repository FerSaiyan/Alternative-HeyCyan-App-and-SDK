    <string name="onboarding_setup">Configuração</string>
    <string name="onboarding_connect_glasses_title">Conecte seus óculos</string>
    <string name="onboarding_connect_glasses_body">O CyanBridge precisa de acesso a dispositivos próximos para encontrar e conectar seus óculos. Em telefones antigos, o Android também pode solicitar localização porque ela é necessária para buscar dispositivos Bluetooth. A permissão de Wi-Fi Direct será solicitada depois, somente ao transferir mídia.</string>
    <string name="onboarding_bluetooth_allowed">Acesso Bluetooth permitido</string>
    <string name="onboarding_bluetooth_denied">O acesso Bluetooth não foi concedido</string>
    <string name="onboarding_allow_glasses_connection">Permitir conexão dos óculos</string>
    <string name="onboarding_permission_granted">Permissão concedida</string>
    <string name="onboarding_media_files_title">Arquivos de mídia e IA</string>
    <string name="onboarding_media_files_body">O CyanBridge usa acesso a arquivos para salvar mídias transferidas dos seus óculos e gerenciar modelos de IA e arquivos locais relacionados. Você pode continuar sem permitir agora, mas a sincronização de mídia e alguns recursos de IA precisarão disso depois.</string>
    <string name="onboarding_file_access_allowed">Acesso a arquivos permitido</string>
    <string name="onboarding_file_access_denied">O acesso a arquivos não foi concedido</string>
    <string name="onboarding_allow_media_access">Permitir acesso a mídia e arquivos de IA</string>
    <string name="onboarding_accessibility_title">Aviso sobre acessibilidade</string>
    <string name="onboarding_accessibility_body">O Local Agent pode ler textos na tela para executar as ações que você solicitar explicitamente. Ele só funciona depois que você ativa o acesso de acessibilidade nas configurações do Android.</string>
    <string name="onboarding_local_agent_toggle">Ativar automação do Local Agent</string>
    <string name="onboarding_accessibility_enabled">A acessibilidade está ativada</string>
    <string name="onboarding_accessibility_disabled">A acessibilidade está desativada</string>
    <string name="onboarding_open_accessibility">Abrir configurações de acessibilidade</string>
    <string name="onboarding_open_source_title">Código aberto por design</string>
    <string name="onboarding_open_source_body">Veja como o CyanBridge funciona, informe problemas de segurança, sugira melhorias ou contribua com código. A revisão da comunidade ajuda a tornar o aplicativo mais seguro e melhor.</string>
