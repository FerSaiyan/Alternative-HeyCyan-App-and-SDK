    <string name="onboarding_welcome_title">Benvenuto in CyanBridge</string>
    <string name="onboarding_welcome_body">Collega i tuoi occhiali intelligenti e configura Android per una connessione stabile in background.</string>
    <string name="onboarding_start_setup">Avvia configurazione</string>
    <string name="onboarding_setup">Configurazione</string>
    <string name="onboarding_connect_glasses_title">Collega i tuoi occhiali</string>
    <string name="onboarding_connect_glasses_body">CyanBridge richiede l'accesso ai dispositivi vicini per trovare e collegare i tuoi occhiali. Sui telefoni meno recenti Android può chiedere anche la posizione, necessaria per la ricerca Bluetooth. Il permesso Wi-Fi Direct verrà richiesto più avanti, solo durante il trasferimento dei media.</string>
    <string name="onboarding_bluetooth_allowed">Accesso Bluetooth consentito</string>
    <string name="onboarding_bluetooth_denied">Accesso Bluetooth non concesso</string>
    <string name="onboarding_allow_glasses_connection">Consenti connessione occhiali</string>
    <string name="onboarding_permission_granted">Permesso concesso</string>
    <string name="onboarding_media_files_title">File multimediali e IA</string>
    <string name="onboarding_media_files_body">CyanBridge usa l'accesso ai file per salvare i media trasferiti dagli occhiali e gestire i modelli IA e i relativi file locali. Puoi continuare senza concederlo ora, ma la sincronizzazione dei media e alcune funzioni IA ne avranno bisogno in seguito.</string>
    <string name="onboarding_file_access_allowed">Accesso ai file consentito</string>
    <string name="onboarding_file_access_denied">Accesso ai file non concesso</string>
    <string name="onboarding_allow_media_access">Consenti accesso a media e file IA</string>
    <string name="onboarding_accessibility_title">Informativa sull'accessibilità</string>
    <string name="onboarding_accessibility_body">Local Agent può leggere il testo sullo schermo per eseguire le azioni richieste esplicitamente. Non funziona finché non abiliti l'accesso all'accessibilità nelle impostazioni Android.</string>
    <string name="onboarding_local_agent_toggle">Abilita automazione Local Agent</string>
    <string name="onboarding_accessibility_enabled">L'accessibilità è abilitata</string>
    <string name="onboarding_accessibility_disabled">L'accessibilità è disabilitata</string>
    <string name="onboarding_open_accessibility">Apri impostazioni accessibilità</string>
    <string name="onboarding_open_source_title">Open source per scelta</string>
    <string name="onboarding_open_source_body">Scopri come funziona CyanBridge, segnala problemi di sicurezza, suggerisci miglioramenti o contribuisci al codice. La revisione della community rende l'app più sicura e migliore.</string>
    <string name="onboarding_open_github">Apri CyanBridge su GitHub</string>
