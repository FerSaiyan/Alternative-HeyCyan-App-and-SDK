    <string name="onboarding_benefit_ai_title">IA sempre por perto</string>
    <string name="onboarding_benefit_ai_body">Use inteligência local e mantenha o controle dos seus dados.</string>
    <string name="onboarding_benefit_capture_title">Capture o momento</string>
    <string name="onboarding_benefit_capture_body">Transforme fotos, áudios e ideias em memórias úteis.</string>
