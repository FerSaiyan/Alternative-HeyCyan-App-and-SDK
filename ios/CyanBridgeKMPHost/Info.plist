<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt-BR</string>
		<string>es</string>
		<string>de</string>
		<string>fr</string>
		<string>it</string>
		<string>zh-Hans</string>
		<string>ko</string>
		<string>ru</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cyanbridge</string>
			</array>
		</dict>
	</array>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>cyanbridge://</string>
		<key>MetaAppID</key>
		<string>0</string>
		<key>ClientToken</key>
		<string></string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
		<key>CrashReporting</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>CyanBridge records voice questions and audio messages when you ask it to.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>CyanBridge saves photos and videos imported from your glasses to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CyanBridge lets you attach photos to chats.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>CyanBridge plugins turn what the glasses microphone hears into captions, translations, notes and reminders.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>processing</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
		<string>ql.iap2.protocol02</string>
		<string>ql.iap2.protocol01</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
