    <string name="onboarding_language_title">앱 언어 선택</string>
    <string name="onboarding_language_description">온보딩, 플러그인 설정, 화면 및 대화 상자에 사용할 CyanBridge 언어를 선택하세요.</string>
    <string name="onboarding_language_continue">계속</string>
    <string name="onboarding_welcome_title">CyanBridge에 오신 것을 환영합니다</string>
    <string name="onboarding_welcome_body">스마트 안경을 연결하고 안정적인 백그라운드 연결을 위해 Android를 구성하세요.</string>
    <string name="onboarding_start_setup">설정 시작</string>
    <string name="onboarding_setup">설정</string>
    <string name="onboarding_connect_glasses_title">안경 연결</string>
    <string name="onboarding_connect_glasses_body">CyanBridge가 안경을 검색하고 연결하려면 주변 기기 권한이 필요합니다. 이전 휴대전화에서는 Bluetooth 검색에 위치 권한이 필요하므로 Android가 위치 권한을 요청할 수도 있습니다. Wi-Fi Direct 권한은 미디어를 전송할 때 나중에 요청됩니다.</string>
    <string name="onboarding_bluetooth_allowed">Bluetooth 권한이 허용됨</string>
    <string name="onboarding_bluetooth_denied">Bluetooth 권한이 허용되지 않음</string>
    <string name="onboarding_allow_glasses_connection">안경 연결 허용</string>
    <string name="onboarding_permission_granted">권한이 허용됨</string>
    <string name="onboarding_media_files_title">미디어 및 AI 파일</string>
    <string name="onboarding_media_files_body">CyanBridge는 안경에서 전송된 미디어를 저장하고 AI 모델 및 관련 로컬 파일을 관리하기 위해 파일 접근 권한을 사용합니다. 지금 허용하지 않고 계속할 수 있지만 미디어 동기화와 일부 AI 기능에는 나중에 권한이 필요합니다.</string>
    <string name="onboarding_file_access_allowed">파일 접근이 허용됨</string>
    <string name="onboarding_file_access_denied">파일 접근이 허용되지 않음</string>
    <string name="onboarding_allow_media_access">미디어 및 AI 파일 접근 허용</string>
    <string name="onboarding_accessibility_title">접근성 안내</string>
    <string name="onboarding_accessibility_body">Local Agent는 사용자가 명시적으로 요청한 작업을 수행하기 위해 화면의 텍스트를 읽을 수 있습니다. Android 설정에서 접근성 권한을 활성화하기 전에는 실행되지 않습니다.</string>
    <string name="onboarding_local_agent_toggle">Local Agent 자동화 사용</string>
    <string name="onboarding_accessibility_enabled">접근성이 현재 사용 설정됨</string>
    <string name="onboarding_accessibility_disabled">접근성이 현재 사용 중지됨</string>
    <string name="onboarding_open_accessibility">접근성 설정 열기</string>
    <string name="onboarding_open_source_title">오픈 소스를 기본으로</string>
    <string name="onboarding_open_source_body">CyanBridge의 작동 방식을 확인하고 보안 문제를 신고하거나 개선 사항을 제안하거나 코드에 기여하세요. 커뮤니티 검토는 앱을 더 안전하고 유용하게 만듭니다.</string>
    <string name="onboarding_open_github">GitHub에서 CyanBridge 열기</string>
