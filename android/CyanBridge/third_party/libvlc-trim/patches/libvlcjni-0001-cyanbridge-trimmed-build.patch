+# CyanBridge trim: only these modules are linked into libvlc.so. One name per
+# line, comments allowed; see third_party/libvlc-trim/modules.txt in CyanBridge.
+VLC_MODULE_WHITELIST="$(sed -e 's/#.*//' "${AVLC_MODULES_FILE:?AVLC_MODULES_FILE is not set}" | tr -s ' \t' '\n' | grep -v '^$')"
 
 ###########################
 # Build buildsystem tools #
@@ -459,7 +399,7 @@ export PATH="$VLC_SRC_DIR/extras/tools/build/bin:$PATH"
 echo "Building tools"
 (cd $VLC_SRC_DIR/extras/tools && ./bootstrap)
 avlc_checkfail "buildsystem tools: bootstrap failed"
-make -C $VLC_SRC_DIR/extras/tools $MAKEFLAGS
+make -C $VLC_SRC_DIR/extras/tools $MAKEFLAGS .buildlibtool
 avlc_checkfail "buildsystem tools: make failed"
 
 VLC_CONTRIB="$VLC_SRC_DIR/contrib/$TARGET_TUPLE"
@@ -494,12 +434,7 @@ mkdir -p $VLC_CONTRIB_DIR/lib/pkgconfig
 # before ">> config.make" when switching to VLC 4.0
 rm -f $VLC_CONTRIB_DIR/config.mak
 
-# gettext
-if which autopoint >/dev/null; then
-    VLC_CONTRIB_ARGS="$VLC_CONTRIB_ARGS --enable-gettext"
-else
-    VLC_CONTRIB_ARGS="$VLC_CONTRIB_ARGS --disable-gettext"
-fi
+VLC_CONTRIB_ARGS="$VLC_CONTRIB_ARGS --disable-gettext"
 
 case $AVLC_CONTRIB_LICENSE in
     l)
@@ -548,6 +483,7 @@ else
     echo "AS=${CROSS_TOOLS}as" >> $VLC_CONTRIB_DIR/config.mak
     echo "RANLIB=${CROSS_TOOLS}ranlib" >> $VLC_CONTRIB_DIR/config.mak
     echo "LD=${CROSS_TOOLS}ld" >> $VLC_CONTRIB_DIR/config.mak
+    echo "FFMPEG_TRIM_CONF=${AVLC_FFMPEG_TRIM_CONF:?AVLC_FFMPEG_TRIM_CONF is not set}" >> $VLC_CONTRIB_DIR/config.mak
 
     # fix modplug endianess check (narrowing error)
     export ac_cv_c_bigendian=no
@@ -555,12 +491,8 @@ else
     # list packages to be built
     make -C $VLC_CONTRIB_DIR TARBALLS="$VLC_TARBALLS" list
 
-    make -C $VLC_CONTRIB_DIR TARBALLS="$VLC_TARBALLS" $MAKEFLAGS fetch
-    avlc_checkfail "contribs: make fetch failed"
-
-    #export the PATH
-    # Make
-    make -C $VLC_CONTRIB_DIR TARBALLS="$VLC_TARBALLS" $MAKEFLAGS -k || make -C $VLC_CONTRIB_DIR TARBALLS="$VLC_TARBALLS" $MAKEFLAGS -j1
+    # CyanBridge trim: build (and fetch) only the selected contribs and their deps
+    make -C $VLC_CONTRIB_DIR TARBALLS="$VLC_TARBALLS" $MAKEFLAGS ${AVLC_CONTRIB_TARGETS}
     avlc_checkfail "contribs: make failed"
 
     # Make prebuilt contribs package
@@ -649,14 +581,14 @@ rm -rf ${REDEFINED_VLC_MODULES_DIR}
 mkdir -p ${REDEFINED_VLC_MODULES_DIR}
 
 echo "Generating static module list"
-blacklist_regexp=
-for i in ${VLC_MODULE_BLACKLIST}
+whitelist_regexp=
+for i in ${VLC_MODULE_WHITELIST}
 do
-    if [ -z "${blacklist_regexp}" ]
+    if [ -z "${whitelist_regexp}" ]
     then
-        blacklist_regexp="${i}"
+        whitelist_regexp="${i}"
     else
-        blacklist_regexp="${blacklist_regexp}|${i}"
+        whitelist_regexp="${whitelist_regexp}|${i}"
     fi
 done
 
diff --git a/libvlc/jni/Android.mk b/libvlc/jni/Android.mk
index 7068558..d1c7560 100644
--- a/libvlc/jni/Android.mk
+++ b/libvlc/jni/Android.mk
@@ -33,7 +33,6 @@ LOCAL_LDLIBS := \
     $(VLC_BUILD_DIR)/compat/.libs/libcompat.a \
     $(VLC_CONTRIB_LDFLAGS) \
     -ldl -lz -lm -llog \
-    -ljpeg \
     $(VLC_LDFLAGS) \
     -Wl,-Bsymbolic
 LOCAL_CXXFLAGS := -std=c++11
diff --git a/libvlc/jni/libvlcjni.c b/libvlc/jni/libvlcjni.c
index a051674..d21b241 100644
--- a/libvlc/jni/libvlcjni.c
+++ b/libvlc/jni/libvlcjni.c
@@ -34,9 +34,11 @@
 
 #include <android/api-level.h>
 
+#ifdef HAVE_FONTCONFIG
 # include <limits.h>
 # include <time.h>
 # include <fontconfig/fontconfig.h>
+#endif
 
 #include "libvlcjni-vlcobject.h"
 #include "utils.h"
@@ -485,6 +487,7 @@ jstring Java_org_videolan_libvlc_LibVLC_changeset(JNIEnv* env, jobject thiz)
     return vlcNewStringUTF(env, libvlc_get_changeset());
 }
 
+#ifdef HAVE_FONTCONFIG
 /* A lock left behind by a process killed mid-scan blocks the cache of that
  * directory until fontconfig considers it stale, which takes 10 minutes. The
  * locks we take ourselves are only held for a fraction of a second, so anything
@@ -579,6 +582,16 @@ jboolean Java_org_videolan_libvlc_LibVLC_nativeBuildFontCache(JNIEnv *env,
 
     return b_cached;
 }
+#else
+/* Built without fontconfig (and without the freetype text renderer): there is
+ * no font cache to build. */
+jboolean Java_org_videolan_libvlc_LibVLC_nativeBuildFontCache(JNIEnv *env,
+                                                            jobject thiz)
+{
+    (void) env; (void) thiz;
+    return JNI_TRUE;
+}
+#endif
 
 void Java_org_videolan_libvlc_LibVLC_nativeSetUserAgent(JNIEnv* env,
                                                         jobject thiz,
